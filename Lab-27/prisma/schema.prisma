datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  UserID   String
  UserName String
  Password String
}

model Task {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  TaskID          String
  TaskTitle       String
  TaskDescription String
  IsCompleted     Boolean @default(false)
  UserID          String
}
